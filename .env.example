# New Go/MySQL stack. Fill every secret locally; never commit .env.
APP_ENV=development
SESSION_SECRET=
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=
# Only the db container receives this bootstrap secret.
MYSQL_ROOT_PASSWORD=
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=2097152
SESSION_TTL_SECONDS=28800
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=300
# Trust only the web proxy network selected in compose.
TRUSTED_PROXY_CIDRS=
WEB_PORT=8080
# Optional real dialogue model gateway for fifth-lesson streaming chat.
# Fourth-lesson /api/ask uses a local evidence-only generator when these are empty.
DIALOGUE_BASE_URL=
DIALOGUE_MODEL=
DIALOGUE_API_KEY=
DIALOGUE_TIMEOUT_SECONDS=60
DIALOGUE_MAX_OUTPUT_TOKENS=2048
HISTORY_MAX_MESSAGES=12
HISTORY_MAX_CHARACTERS=24000
# Optional embedding + vector pipeline (all-or-nothing). Injected into the API
# only; leave every variable empty to run keyword-only retrieval.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=
EMBEDDING_TIMEOUT_SECONDS=30
QDRANT_BASE_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=campusclaw_chunks
QDRANT_TIMEOUT_SECONDS=10
# Legacy Flask configuration, retained until the verified migration/cutover.
SECRET_KEY=
DATABASE_PATH=/data/campusclaw.sqlite3
ALLOWED_EXTENSIONS=txt,md

# Optional direct connection to an independently prepared acceptance-test stack.
# Never point these at the application database; --compose configures them itself.
APITEST_BASE_URL=http://localhost:18080
APITEST_DB_HOST=127.0.0.1
APITEST_DB_PORT=3306
APITEST_DB_NAME=campusclaw_apitest
APITEST_DB_USER=campusclaw
APITEST_DB_PASSWORD=
APITEST_PROVIDER=real
