# New Go/MySQL stack. Fill every secret locally; never commit .env.
APP_ENV=development
SESSION_SECRET=
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=
# Only the db container receives this bootstrap secret.
MYSQL_ROOT_PASSWORD=
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=2097152
SESSION_TTL_SECONDS=28800
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=300
# Trust only the web proxy network selected in compose.
TRUSTED_PROXY_CIDRS=
WEB_PORT=8080
# Legacy Flask configuration, retained until the verified migration/cutover.
SECRET_KEY=
DATABASE_PATH=/data/campusclaw.sqlite3
ALLOWED_EXTENSIONS=txt,md
